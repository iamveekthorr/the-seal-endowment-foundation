# Copy this file to .env and fill in the real values.

# --- Sanity ---------------------------------------------------------------
# From sanity.io/manage → your project → Settings
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-02-01

# A token with "Viewer" (read) rights is enough for the live site.
# Create one at sanity.io/manage → API → Tokens.
SANITY_API_READ_TOKEN=

# Only needed to run `pnpm seed` (scripts/seed.ts) — a token with "Editor"
# rights so the seed script can create/update content. Never expose this
# to the browser (no NEXT_PUBLIC_ prefix) and never commit it.
SANITY_API_WRITE_TOKEN=

# Shared secret for the /api/revalidate webhook — set the same value here
# and on the webhook you configure in sanity.io/manage → API → Webhooks.
SANITY_REVALIDATE_SECRET=

# --- Cyberpay (donations) --------------------------------------------------
# From your Cyberpay merchant dashboard. Use the *.test.cyberpay.link key
# while developing, swap for the live key (and CYBERPAY_BASE_URL) at launch.
CYBERPAY_API_KEY=
CYBERPAY_BASE_URL=https://api.test.cyberpay.link

# Your brand's webhook *signature* secret (Cyberpay dashboard → Webhooks) —
# NOT the same as CYBERPAY_API_KEY. Used to verify the X-Signature header
# on incoming POST /api/donate/webhook calls (HMAC-SHA256, base64).
CYBERPAY_SIGNATURE_KEY=

# Where Cyberpay's hosted cashier redirects the donor back to after payment.
# Must be a full URL reachable from the donor's browser (use an ngrok/tunnel
# URL in local dev if you need to test the redirect end to end).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
